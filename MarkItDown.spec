    _tmp_dir.mkdir(parents=True, exist_ok=True)
    shutil.copy2(_blocks_events, _tmp_dir / "blocks_events.py")
    print(f"[MarkItDown.spec] blocks_events.py found at {_blocks_events} (size={_blocks_events.stat().st_size})")
else:
    print(f"[MarkItDown.spec] WARNING: {_blocks_events} not found - gradio codegen may not have run")

