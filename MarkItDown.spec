block_cipher = None

a = Analysis(
    ["markitdown_gui.py"],
    pathex=[],
    binaries=[],
    datas=datas,
    hiddenimports=hidden_imports,
    hookspath=[],
    hooksconfig={},
    runtime_hooks=["_pyinstaller_runtime_hook.py"],
    excludes=excludes,
    noarchive=False,
    optimize=2,  # PYO bytecode optimization -> smaller frozen bytecode
)


pyz = PYZ(a.pure, cipher=block_cipher)

# -- onefile: single MarkItDown.exe (no _internal/ directory) ---------
exe = EXE(
    pyz,
    a.scripts,
    a.binaries,
    a.datas,
    [],
    name="MarkItDown",
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=True,
    upx_exclude=[
        "libcrypto-3.dll",
        "libssl-3.dll",
        "python311.dll",
        "vcruntime140.dll",
        "vcruntime140_1.dll",
        "ucrtbase.dll",
    ],
    runtime_tmpdir=None,
