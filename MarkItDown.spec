# --- PyInstaller onefile fix: patch gradio/component_meta.py --------------
# In one-file builds, component_meta.create_or_modify_pyi fails because
# it reads .py source files from inside the PYZ archive (which returns empty),
# causing ValueError: Couldn't find class source code.
# Strategy:
#   1. The patch file (_internal_patches/component_meta.py) has the original
#      component_meta.py source base64-embedded inside it.
#   2. At runtime, the patch exec's the original source, preserving all classes.
#   3. Only create_or_modify_pyi and get_local_contexts are overridden (no-op).
_internal_patch = Path("_internal_patches") / "component_meta.py"
_gradio_patch_src = None
_gradio_patch_backup = None
if _internal_patch.exists():
    import gradio as _gr_tmp
    _gradio_patch_src = Path(_gr_tmp.__file__).parent / "component_meta.py"
    _gradio_patch_backup = _gradio_patch_src.with_suffix(".py.bak")
    try:
        shutil.copy2(_gradio_patch_src, _gradio_patch_backup)
        shutil.copy2(_internal_patch, _gradio_patch_src)
        print(f"[MarkItDown.spec] Patched gradio/component_meta.py -> {_gradio_patch_src}")
        # Remove cached gradio modules so Analysis re-reads from disk (patched version)
        for _mod in list(sys.modules.keys()):
            if _mod == "gradio" or _mod.startswith("gradio."):
                del sys.modules[_mod]
        print(f"[MarkItDown.spec] Cleared gradio module cache")
    except (PermissionError, OSError) as _patch_err:
        _gradio_patch_src = None
        _gradio_patch_backup = None
        print(f"[MarkItDown.spec] WARNING: could not patch gradio in-place ({_patch_err})")
        print(f"[MarkItDown.spec] The runtime hook (_pyinstaller_runtime_hook.py) will handle component_meta at runtime.")
else:
    print(f"[MarkItDown.spec] WARNING: {_internal_patch} not found - gradio patch will NOT be applied!")

